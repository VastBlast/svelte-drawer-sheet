{
	"name": "svelte-drawer-sheet",
	"version": "0.1.6",
	"description": "A fast, accessible, unstyled drawer/sheet primitive for Svelte 5.",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm build:site && pnpm package",
		"build:site": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"package": "svelte-kit sync && svelte-package",
		"prepack": "pnpm package",
		"prepublishOnly": "pnpm validate",
		"check": "svelte-kit sync && svelte-check --config ./vite.config.ts --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --config ./vite.config.ts --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:browser": "vitest run --project browser",
		"test:watch": "vitest",
		"validate": "pnpm lint && pnpm check && pnpm test && pnpm package && publint --strict"
	},
	"files": [
		"dist",
		"THIRD_PARTY_NOTICES.md",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"publishConfig": {
		"access": "public"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": ">=5.40.0 <6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.0",
		"@vitest/browser-playwright": "^5.0.2",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.24",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.1",
		"vitest": "^5.0.2",
		"vitest-browser-svelte": "^3.1.0"
	},
	"keywords": [
		"svelte",
		"drawer",
		"bottom-sheet",
		"dialog",
		"accessible",
		"headless"
	]
}
